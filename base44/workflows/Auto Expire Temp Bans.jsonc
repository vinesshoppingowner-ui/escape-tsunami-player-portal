{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_expire_temp_bans",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expire_bans": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireTempBans"
          },
          "then": "end",
          "x-base44": {
            "title": "Expire finished temp bans",
            "description": "Unban in-game + notify player"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Auto Expire Temp Bans",
  "description": "Every 15 minutes, expires temporary bans whose time is up and unbans the player in-game"
}