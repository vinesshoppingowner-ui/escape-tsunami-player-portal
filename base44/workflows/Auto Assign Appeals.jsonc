{
  "description": "When a new appeal is submitted, ensure it starts as Pending with cleared staff decision fields, and assign it to the staff member with the fewest open appeals (when auto-assign is switched on)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Appeal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_assign_appeals",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "assign_appeal": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoAssignAppeal",
            "args": {
              "appeal_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sanitize & assign appeal",
            "description": "Enforce Pending & assign"
          }
        }
      }
    ]
  },
  "name": "Auto Assign Appeals"
}