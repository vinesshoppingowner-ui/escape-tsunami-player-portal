{
  "name": "Developer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the collectible Developer"
    },
    "rarity": {
      "type": "string",
      "description": "Rarity tier",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Mythic"
      ],
      "default": "Common"
    },
    "earnings_per_sec": {
      "type": "number",
      "description": "Cash earned per second when owned",
      "default": 1
    },
    "image_url": {
      "type": "string",
      "description": "Avatar / artwork image URL"
    },
    "description": {
      "type": "string",
      "description": "Short flavor text"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order (lower first)",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}