{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "staff",
        "user"
      ]
    },
    "roblox_username": {
      "type": "string",
      "description": "The player's Roblox username, used to link in-game moderations"
    },
    "is_owner": {
      "type": "boolean",
      "description": "Whether this user is an owner (auto-set for @staffwaitrose.net accounts)",
      "default": false
    },
    "banned": {
      "type": "boolean",
      "description": "Whether this user account has been banned from the portal",
      "default": false
    },
    "banned_reason": {
      "type": "string",
      "description": "Reason for the portal ban"
    },
    "banned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the portal ban was issued"
    },
    "banned_by": {
      "type": "string",
      "description": "Email of the staff member who banned this account"
    },
    "google_locked": {
      "type": "boolean",
      "description": "When true, the user cannot log in via Google OAuth",
      "default": false
    },
    "force_password_reset": {
      "type": "boolean",
      "description": "When true, the user must reset their password on next login",
      "default": false
    },
    "appeals_locked": {
      "type": "boolean",
      "description": "When true, the user cannot submit new appeals",
      "default": false
    },
    "has_password": {
      "type": "boolean",
      "description": "Whether the user has set a password (true for email/password registrants, false for Google-only users)",
      "default": false
    },
    "suspended": {
      "type": "boolean",
      "description": "When true, the user is suspended from all portal activity but can still log in to view their status",
      "default": false
    },
    "suspended_reason": {
      "type": "string",
      "description": "Reason for the suspension"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the suspension was issued"
    },
    "suspended_by": {
      "type": "string",
      "description": "Email of the staff member who suspended this account"
    },
    "muted_until": {
      "type": "string",
      "format": "date-time",
      "description": "When the user's mute expires (prevents appeal chat messages)"
    },
    "roblox_verified": {
      "type": "boolean",
      "description": "Whether the user's Roblox account has been verified",
      "default": false
    },
    "staff_notes_private": {
      "type": "string",
      "description": "Private admin-only notes about this user account"
    },
    "last_ip": {
      "type": "string",
      "description": "The last IP address the user logged in from"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "When the user last logged in"
    },
    "denied_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff powers an admin has switched off for this user"
    },
    "login_attempts": {
      "type": "number",
      "description": "Count of failed login attempts",
      "default": 0
    }
  },
  "required": [
    "role"
  ]
}