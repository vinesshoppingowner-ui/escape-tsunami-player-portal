{
  "name": "Appeal",
  "type": "object",
  "properties": {
    "moderation_id": {
      "type": "string",
      "description": "Reference to the Moderation being appealed"
    },
    "roblox_username": {
      "type": "string",
      "description": "The Roblox username of the player submitting the appeal"
    },
    "appeal_reason": {
      "type": "string",
      "description": "The player's explanation for why the moderation should be lifted"
    },
    "status": {
      "type": "string",
      "description": "Review state of the appeal",
      "enum": [
        "Pending",
        "Under Review",
        "Approved",
        "Denied"
      ],
      "default": "Pending"
    },
    "staff_response": {
      "type": "string",
      "description": "Optional response from the staff team reviewing the appeal"
    }
  },
  "required": [
    "moderation_id",
    "appeal_reason"
  ]
}