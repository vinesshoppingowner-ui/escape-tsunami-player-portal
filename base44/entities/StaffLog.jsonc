{
  "name": "StaffLog",
  "type": "object",
  "properties": {
    "staff_username": {
      "type": "string",
      "description": "The staff member who performed the action"
    },
    "action": {
      "type": "string",
      "description": "What kind of staff action was performed",
      "enum": [
        "appeal_decision",
        "appeal_assigned",
        "moderation_issued",
        "moderation_edited",
        "moderation_deleted",
        "user_role_changed",
        "permissions_changed",
        "action_undone"
      ]
    },
    "target": {
      "type": "string",
      "description": "Who or what was acted on, e.g. a Roblox username or appeal reference"
    },
    "detail": {
      "type": "string",
      "description": "Short human-readable summary of the action"
    },
    "undo_ops": {
      "type": "string",
      "description": "JSON list of operations that revert this action"
    },
    "undone": {
      "type": "boolean",
      "default": false,
      "description": "Whether an admin reverted this action"
    },
    "undone_by": {
      "type": "string",
      "description": "Admin who reverted the action"
    },
    "undone_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the action was reverted"
    }
  },
  "required": [
    "staff_username",
    "action",
    "detail"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}