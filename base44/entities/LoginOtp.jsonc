{
  "name": "LoginOtp",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "The email address the verification code was sent to"
    },
    "code": {
      "type": "string",
      "description": "The 6-digit verification code"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires (10 minutes after creation)"
    }
  },
  "required": [
    "email",
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}