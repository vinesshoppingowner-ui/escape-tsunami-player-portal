{
  "name": "BugReport",
  "type": "object",
  "properties": {
    "roblox_username": {
      "type": "string",
      "description": "The Roblox username of the player reporting the bug"
    },
    "title": {
      "type": "string",
      "description": "Short summary of the bug"
    },
    "description": {
      "type": "string",
      "description": "Steps to reproduce, what was expected, and what actually happened"
    },
    "severity": {
      "type": "string",
      "description": "How impactful the bug is",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Low"
    },
    "status": {
      "type": "string",
      "description": "Review state of the bug report",
      "enum": [
        "Submitted",
        "Confirmed",
        "Declined"
      ],
      "default": "Submitted"
    }
  },
  "required": [
    "roblox_username",
    "title",
    "description"
  ]
}