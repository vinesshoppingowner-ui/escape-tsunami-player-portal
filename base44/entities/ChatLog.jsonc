{
  "name": "ChatLog",
  "type": "object",
  "properties": {
    "roblox_username": {
      "type": "string",
      "description": "Roblox username of the player who sent the message"
    },
    "message": {
      "type": "string",
      "description": "The chat message content as the player typed it"
    },
    "filtered_message": {
      "type": "string",
      "description": "The message after Roblox's own text filter ran on it \u2014 censored or rephrased text"
    },
    "roblox_flagged": {
      "type": "boolean",
      "description": "True when Roblox's text filter changed the message, meaning Roblox considered it inappropriate",
      "default": false
    },
    "server_name": {
      "type": "string",
      "description": "The game server where the message was sent"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent in-game"
    }
  },
  "required": [
    "roblox_username",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}