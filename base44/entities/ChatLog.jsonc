{
  "name": "ChatLog",
  "type": "object",
  "properties": {
    "roblox_username": {
      "type": "string",
      "description": "Roblox username of the player who sent the message"
    },
    "message": {
      "type": "string",
      "description": "The chat message content"
    },
    "server_name": {
      "type": "string",
      "description": "The game server where the message was sent"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was sent in-game"
    }
  },
  "required": [
    "roblox_username",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}