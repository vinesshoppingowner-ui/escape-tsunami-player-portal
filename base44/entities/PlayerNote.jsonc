{
  "name": "PlayerNote",
  "type": "object",
  "properties": {
    "roblox_username": {
      "type": "string",
      "description": "The player this note is about"
    },
    "note": {
      "type": "string",
      "description": "Private staff note"
    },
    "author": {
      "type": "string",
      "description": "Staff member who wrote the note"
    }
  },
  "required": [
    "roblox_username",
    "note"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}