{
  "name": "LeaderboardEntry",
  "type": "object",
  "properties": {
    "roblox_username": {
      "type": "string",
      "description": "Roblox username of the player"
    },
    "category": {
      "type": "string",
      "description": "Which leaderboard this entry belongs to",
      "enum": [
        "cash",
        "rebirths",
        "developers",
        "playtime"
      ],
      "default": "cash"
    },
    "value": {
      "type": "number",
      "description": "Score value (cash amount, rebirth count, developer count, or playtime in minutes)",
      "default": 0
    }
  },
  "required": [
    "roblox_username",
    "category",
    "value"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}