{
  "name": "ApplicationResponse",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string",
      "description": "Reference to the Application"
    },
    "application_title": {
      "type": "string",
      "description": "Cached title of the application"
    },
    "roblox_username": {
      "type": "string",
      "description": "Roblox username of the applicant"
    },
    "submitted_by_email": {
      "type": "string",
      "description": "Email of the user who submitted"
    },
    "answers": {
      "type": "string",
      "description": "JSON object of question_id -> answer"
    },
    "status": {
      "type": "string",
      "description": "Review status",
      "enum": [
        "submitted",
        "under_review",
        "accepted",
        "rejected"
      ],
      "default": "submitted"
    },
    "staff_notes": {
      "type": "string",
      "description": "Private staff notes"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of staff who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the response was reviewed"
    }
  },
  "required": [
    "application_id",
    "answers"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.roblox_username": "{{user.data.roblox_username}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_owner": true
          }
        }
      ]
    }
  }
}